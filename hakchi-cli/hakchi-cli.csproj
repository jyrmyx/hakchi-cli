<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Hakchi.Cli</RootNamespace>
    <AssemblyName>hakchi-cli</AssemblyName>
    <Version>0.1.0</Version>
    <Description>Headless CLI for hakchi Classic Minis (macOS / Linux)</Description>
    <!-- Release publish defaults (overridable on CLI) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hakchi.Core\Hakchi.Core.csproj" />
    <ProjectReference Include="..\Hakchi.Usb\Hakchi.Usb.csproj" />
    <ProjectReference Include="..\Hakchi.Fel\Hakchi.Fel.csproj" />
    <ProjectReference Include="..\Hakchi.Clovershell\Hakchi.Clovershell.csproj" />
    <ProjectReference Include="..\Hakchi.Rndis\Hakchi.Rndis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.51.1" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.51.1" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <!-- Default cart art for packages (same as hakchi_gui blanks). -->
  <ItemGroup>
    <None Include="..\assets\blank_nes.png" Link="assets\blank_nes.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\assets\blank_nes_small.png" Link="assets\blank_nes_small.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\assets\blank_nes_small.png')" />
    <None Include="..\assets\blank_snes-us.png" Link="assets\blank_snes-us.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\assets\blank_snes-us.png')" />
    <None Include="..\assets\blank_snes-us_small.png" Link="assets\blank_snes-us_small.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\assets\blank_snes-us_small.png')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hakchi.Cli.Tests" />
  </ItemGroup>

</Project>
